  "weight_denominator": 10,
  "formula": "delta=max(0,target_ovr-base_ovr); denominator=(100-base_ovr)*10; gain=floor(((99-base_stat)*delta*position_weight+floor(denominator/2))/denominator); result=min(99,base_stat+gain)",
